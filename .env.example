# Every value below is required. There are no built-in defaults: startup,
# seeding, and migration-validation all fail with a specific error if any
# value is missing or invalid. These are example values for local
# development, not recommendations.

# Scoring gates (src/domain/scoring.ts ScoringConfig)
# Timing tolerance is a fraction of the interval between consecutive notes,
# so it tightens as tempo climbs: 0.20 is 75ms per note for eighths at
# 80bpm, and 50ms for eighths at 120bpm.
SCORING_TIMING_TOLERANCE_NOTE_FRACTION=0.20
SCORING_MAX_TIMING_FAULTS_PER_RUN=0
# Overlap is reported per step but does not gate pass/fail; this is the
# threshold above which bleed is flagged in the run result, nothing more.
SCORING_OVERLAP_TOLERANCE_US=30000
SCORING_RECOVERY_WINDOW_STEPS=1

# Beat grid: 2 = straight eighths (two notes per metronome click), 1 =
# quarters. Stored per run, so changing it does not corrupt old runs.
EXERCISE_NOTES_PER_BEAT=2

# Progression policy (src/server/config.ts ProgressionPolicy)
PROGRESSION_TEMPO_INCREMENT_BPM=4
PROGRESSION_FAILED_RUN_BEHAVIOR=reset_streak
# Required only when PROGRESSION_FAILED_RUN_BEHAVIOR=step_down:
# PROGRESSION_TEMPO_DECREMENT_BPM=4
# PROGRESSION_MINIMUM_TEMPO_BPM=40

# What "cleared" means for the next-scale recommendation
# (src/domain/progression/recommendation.ts). A scale is cleared once the
# listed directions have each raised their tempo at least once at this octave
# count. Advisory only: nothing is locked either way. docs/SPEC.md calls this
# composition a placeholder to be tuned from real sessions, so expect it to
# move -- these are example values, not recommendations.
RECOMMENDATION_CLEAR_OCTAVES=1
RECOMMENDATION_CLEAR_DIRECTIONS=ascending,descending

# Seed data
SEED_INITIAL_TEMPO_BPM=80
