{
  "name": "piano-aimbotz",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/src/server/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server/index.ts",
    "dev:client": "vite",
    "build": "tsc -b && vite build",
    "start": "npm run build && node --env-file=.env dist/src/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "seed": "tsx --env-file=.env src/server/db/seed.ts",
    "migrate": "tsx src/server/db/migrate.ts",
    "rebuild-progress": "tsx src/server/progress/rebuild.ts",
    "backfill-assessments": "tsx --env-file=.env src/server/db/backfill-assessments.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"*.{json,ts,html}\" \".github/**/*.yml\"",
    "lint": "eslint .",
    "drizzle:generate": "drizzle-kit generate"
  },
  "keywords": [
    "piano",
    "practice",
    "scale-trainer"
  ],
  "author": "Your Name <you@example.com>",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "@sinclair/typebox": "^0.34.52",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
