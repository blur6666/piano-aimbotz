{
  "name": "piano-aimbotz",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/src/server/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server/index.ts",
    "dev:client": "vite",
    "build": "tsc -b && vite build",
    "start": "npm run build && node --env-file-if-exists=.env dist/src/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "seed": "tsx --env-file-if-exists=.env src/server/db/seed.ts",
    "migrate": "tsx src/server/db/migrate.ts",
    "report:data": "node scripts/export-report-data.mjs",
    "report:charts": "node scripts/render-report-charts.mjs",
    "report:html": "node scripts/export-report-html.mjs",
    "rebuild-progress": "tsx --env-file-if-exists=.env src/server/progress/rebuild.ts",
    "rescore-assessments": "tsx --env-file-if-exists=.env src/server/db/rescore-assessments.ts",
    "backfill-assessments": "tsx --env-file-if-exists=.env src/server/db/backfill-assessments.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"*.{json,ts,html}\" \".github/**/*.yml\"",
    "lint": "eslint .",
    "try": "npm run migrate && npm run seed && npm run start"
  },
  "keywords": [
    "piano",
    "practice",
    "scale-trainer"
  ],
  "author": "Your Name <you@example.com>",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "nanoid": "^3.3.18"
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "@sinclair/typebox": "^0.34.52",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.11.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.7",
    "vexflow": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "marked": "^18.0.9",
    "prettier": "^3.9.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
